# SQLite database (path is relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Secret used to sign admin session cookies. Must be 32+ random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string-of-48-chars-or-more"

# Admin account created by `npx prisma db seed` (only used when seeding).
# Change the password from /admin/account after the first login.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Dhonfanu@2026"

# Session cookies are marked Secure in production. Set to "false" ONLY while
# testing a production build over plain http:// (before HTTPS is configured).
COOKIE_SECURE="true"
